<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="upsertUserContact-test-suite.xml" />
<munit:test name="upsert-user-contact-subflow-test" description="Verify that the manager update subflow is called correctly">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock Manager Update Subflow" processor="mule:flow-ref">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="user-manager-update-subflow" attributeName="name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return />
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution >
			<munit:set-event doc:name="Set Initial Event" >
				<munit:variables >
					<munit:variable key="correlationId" value="TEST-ORCH-001" />
					</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref" name="upsert-user-contact-subflow" />
		</munit:execution>

		<munit:validation >
			<munit-tools:verify-call doc:name="Verify Call to Manager Update" 
				processor="mule:flow-ref" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="user-manager-update-subflow" attributeName="name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
	<munit:test name="user-manager-update-subflow-success-test" description="Verify Manager and User ID mapping logic">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock Query User" processor="salesforce:query">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Query User" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="userSFEmployeeNumbers" value="#[[
							{Id: 'SF_USER_001', EmployeeNumber: 'E123', IsActive: 'true'},
							{Id: 'SF_MGR_999', EmployeeNumber: 'MGR999', IsActive: 'true'}
						]]" mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Update Contact" processor="salesforce:update">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Update Contact" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[{success: true}]]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution >
			<munit:set-event doc:name="Set Worker Data">
				<munit:variables >
					<munit:variable key="correlationId" value="TEST-MGR-UPD" />
					<munit:variable key="validWorkers" value="#[[{
						EmpId: 'E123',
						JobPositionDetail: {
							SupervisorEmpId: 'MGR999'
						}
					}]]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref" name="user-manager-update-subflow" />
		</munit:execution>

		<munit:validation >
			<munit-tools:assert-that doc:name="Assert Manager Mapped" 
				expression="#[payload[0].Manager__c]" 
				is="#[MunitTools::equalTo('SF_MGR_999')]" />
			
			<munit-tools:assert-that doc:name="Assert User Mapped" 
				expression="#[payload[0].User__c]" 
				is="#[MunitTools::equalTo('SF_USER_001')]" />

			<munit-tools:verify-call doc:name="Verify SF Update Called" 
				processor="salesforce:update" times="1" />
		</munit:validation>
	</munit:test>
</mule>
