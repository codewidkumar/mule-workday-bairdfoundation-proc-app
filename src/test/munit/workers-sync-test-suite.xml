	<munit:test name="workday-workers-sf-sync-test-case" description="Test worker sync orchestration and license logic">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock IsActive Update" processor="salesforce:update">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Update IsActive to false" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[]]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Query Contact" processor="salesforce:query">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Query Contact" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[{Id: '003Contact001', Employee_ID__c: 'EMP123'}]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Query Profile Ids" processor="salesforce:query">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Query Profile Ids" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[
						{Name: 'Baird System Administrator', Id: 'P_ADMIN_ID'},
						{Name: 'Baird Foundation Standard User', Id: 'P_STD_ID'},
						{Name: 'Community Plus Login', Id: 'P_COMM_ID'}
					]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Query BU Ids" processor="salesforce:query">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Query BU Ids" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[{Baird_BU_ID__c: 'BU_999'}]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Query UserRole Ids" processor="salesforce:query">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Query UserRole Ids" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[{Name: 'Foundation Staff', Id: 'R_STAFF_ID'}]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Sync Workers Subflow" processor="mule:flow-ref">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="sync-workers-to-sf-subflow" attributeName="name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return />
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution >
			<munit:set-event doc:name="Set Input Variables">
				<munit:variables >
					<munit:variable key="correlationId" value="MUNIT-TEST-123" />
					<munit:variable key="invalidWorkers" value="#[[]]" />
					<munit:variable key="salesforceBFSystemAdministrator" value="#[['ADMIN001']]" />
					<munit:variable key="salesforceBFStandardUserAdministrator" value="#[[]]" />
					<munit:variable key="userEmployeeNumbers" value="#[[{EmployeeNumber: 'EMP123', Id: '005User001', IsActive: true, ProfileId: 'P_COMM_ID'}]]" />
					<munit:variable key="validWorkers" value="#[[{
						EmpId: 'EMP123',
						UserName: 'testuser',
						FirstName: 'MUnit',
						LastName: 'Test',
						EmployeeIndicator: 'Y',
						Emails: [{EmailAddressTypeCode: 'BRDEMAIL', EmailAddress: 'munit@baird.com'}],
						Phones: [{TelecommunicationsNumberTypeCode: 'WORK', Type: 'Landline', AreaCode: '414', ContactNumber: '5551212'}],
