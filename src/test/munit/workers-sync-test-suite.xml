	<munit:config name="workers-sync-test-suite.xml" />
	<munit:test name="workers-validation-subflow-test-suite"
		doc:id="773bc7a8-908f-472b-a551-1ec209500dd7"
		description="Test logic for partitioning workers">
		<munit:execution>
			<munit:set-event doc:name="Set Input Data"
				doc:id="dcb0bcf1-6d05-4d9f-80da-94f6535b352e">
				<munit:payload
					value='#[%dw 2.0
    output application/json
    ---
    [
      {
        "EmpId": "E1001",
        "FirstName": "Alice",
        "LastName": "Smith",
        "UserName": "asmith",
        "Emails": [
          { "EmailAddressTypeCode": "BRDEMAIL", "EmailAddress": "alice@company.com" }
        ],
        "EmploymentDetail": {
          "HireDate": "2020-01-01",
          "Active": true
        }
      },
      {
        "EmpId": "E9999",
        "FirstName": "Invalid",
        "LastName": "User",
        "UserName": "iuser",
        "Emails": [],
        "EmploymentDetail": {
          "HireDate": "2020-01-01",
          "Active": true
        }
      }
    ]
  ]'
					mediaType="application/json" />
				<munit:variables>
					<munit:variable key="userEmployeeNumbers"
						value='#[ {"EmployeeNumber": ["E1001", "E1002"]} ]'
						mediaType="application/json" />
				</munit:variables>
			</munit:set-event>

			<flow-ref doc:name="Flow-ref to workers-validation-subflow"
				name="workers-validation-subflow" />
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that
				doc:name="Assert 1 Valid Worker"
				expression="#[sizeOf(vars.validWorkers)]"
				is="#[MunitTools::equalTo(1)]"
				message="Expected 1 valid worker (Alice)" />

			<munit-tools:assert-that
				doc:name="Assert 1 Invalid Worker"
				expression="#[sizeOf(vars.invalidWorkers)]"
				is="#[MunitTools::equalTo(1)]"
				message="Expected 1 invalid worker (Missing Email)" />

			<munit-tools:assert-equals
				doc:name="Verify Valid Worker ID"
				actual="#[vars.validWorkers[0].EmpId]" expected='#[ "E1001" ]'
				message="The valid worker should be E1001" />
		</munit:validation>
	</munit:test>
