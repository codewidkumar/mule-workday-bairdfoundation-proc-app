						EmploymentDetail: {Active: true, EmployeeTypeCode: 'R'},
						Department: {Name: 'Engineering', GlCode: 'GL-001'},
						BusinessUnitOrganization: {Descriptor: {Id: 'BU_999', Name: 'Baird BU'}, Level: 1}
					}]]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref" name="workday-workers-sf-sync" />
		</munit:execution>

		<munit:validation >
