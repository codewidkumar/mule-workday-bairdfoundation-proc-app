	<sub-flow name="upsert-user-contact-subflow" doc:id="2c176368-7485-4180-9f1a-ef4cd906a655" >
		<flow-ref doc:name="Flow Reference to workers-sync-sub-flow" doc:id="e7f7f43e-0dbc-4871-b9d9-88d9f7011f9d" name="workers-sync-subflow" />
		<flow-ref doc:name="Flow Reference to contacts-validation-final-subflow" doc:id="f5127487-e072-41ac-a8de-9755a12f9b44" name="contacts-validation-final-subflow" />
	</sub-flow>
	<sub-flow name="workers-sync-subflow" doc:id="10cc51db-5935-41c8-903b-0ce4c35f6199" >
		<salesforce:query doc:name="Query User" doc:id="6bae857c-a386-4fc9-a640-056d3876947d" config-ref="Salesforce_Config">
			<salesforce:salesforce-query ><![CDATA[SELECT Id FROM User where ContactId = null]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="extract sf-userId" doc:id="863b6d7f-7ad5-4ded-b36a-1984a2686d6e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/dw
---
"('" ++ (payload.records.Id default [] joinBy "','") ++ "')"
]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="frame query for contacts" doc:id="7542afd0-733a-4abe-bfb6-e2b6c30f3bcf" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"update":"select Id, User__c from contact where User__c IN " ++ (payload default "")
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<salesforce:query doc:name="Query1" doc:id="c46dff3d-c5db-4c9d-930e-c30f0c572390" config-ref="Salesforce_Config" target="Finalcontactdetails" >
			<salesforce:salesforce-query ><![CDATA[#[payload.update]]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Transform Message3" doc:id="0df2c720-06f6-4288-a1cc-554fc75f78ff" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload.records map ((item,value)->{
	"ContactId":item.Id,
	"Id": item.User__c
})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="fbf05581-50ea-4035-a712-f69357c05910" collection="#[payload]">
			<salesforce:update type="User" doc:name="Update" doc:id="a3641db2-c2cb-4a00-a6ba-3e7f087b577b" config-ref="Salesforce_Config" />
		</foreach>
	</sub-flow>
	<sub-flow name="contacts-validation-final-subflow" doc:id="0f43d91b-0d78-44ab-9bef-edc438e285bb" >
		<salesforce:query doc:name="Query Contacts" doc:id="dd0275d0-f30a-40d9-a3a2-caf138f26fd9" config-ref="Salesforce_Config" >
			<salesforce:salesforce-query ><![CDATA[SELECT Id FROM Contact where User__c = null]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Transform Message1" doc:id="e5697939-06e9-4136-a140-952561349734" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"('" ++ (payload.records.Id default [] joinBy "','") ++ "')"]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Transform Message2" doc:id="0278375d-6308-4c5b-b8ae-0d8bbb07581b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"update":"select Id,ContactId from User where ContactId IN " ++ (payload default "")
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<salesforce:query doc:name="Query1" doc:id="7cb19b27-d2ef-4b6e-8112-5792070eb066" config-ref="Salesforce_Config" target="Finalcontactupsert" >
			<salesforce:salesforce-query ><![CDATA[#[payload.update]]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Transform Message3" doc:id="c78bfb60-96c2-455a-a67d-66e90c7ded8f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload.records map ((item,index)->{
	"Id": item.ContactId,
	"User__c": item.Id
})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="ef024bdf-5767-4873-b348-c2f3c5882163" collection="#[payload]">
			<salesforce:update type="Contact" doc:name="Update" doc:id="31294b85-a872-4c1e-a02a-54dbe989a8ca" config-ref="Salesforce_Config" />
		</foreach>
	</sub-flow>
</mule>
