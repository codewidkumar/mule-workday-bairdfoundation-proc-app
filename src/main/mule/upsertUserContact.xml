<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="47603b0b-2b8b-4ca6-b385-a32181496cb8" >
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>
	<flow name="upsertUserContactFlow" doc:id="97652c4f-a71a-446a-b3a5-9f6f03cceaba" >
		<http:listener doc:name="Listener" doc:id="05aaac40-c23d-418c-a77e-46c506aecdd4" path="/workday" config-ref="HTTP_Listener_config"/>
		<flow-ref doc:name="Flow Reference" doc:id="245ed863-4ccf-493a-856a-a9be3c14365f" name="upsert-user-contact-subflow"/>
	</flow>
	<sub-flow name="upsert-user-contact-subflow" doc:id="2c176368-7485-4180-9f1a-ef4cd906a655" >
		<flow-ref doc:name="Flow Reference to workers-sync-sub-flow" doc:id="e7f7f43e-0dbc-4871-b9d9-88d9f7011f9d" name="workers-sync-subflow" />
		<flow-ref doc:name="Flow Reference to contacts-validation-final-subflow" doc:id="f5127487-e072-41ac-a8de-9755a12f9b44" name="contacts-validation-final-subflow" />
		<flow-ref doc:name="Flow Reference to user-manager-update-subflow" doc:id="c0f17dd5-f881-4f25-8889-34c676b7398e" name="user-manager-update-subflow"/>
	</sub-flow>
	<sub-flow name="workers-sync-subflow" doc:id="10cc51db-5935-41c8-903b-0ce4c35f6199" >
		<salesforce:query doc:name="Query User" doc:id="6bae857c-a386-4fc9-a640-056d3876947d" config-ref="Salesforce_Config">
			<salesforce:salesforce-query ><![CDATA[SELECT Id FROM User where ContactId = null and IsActive = true]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Extract SF-UserId" doc:id="863b6d7f-7ad5-4ded-b36a-1984a2686d6e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/dw
---
"('" ++ (payload.Id default [] joinBy "','") ++ "')"
]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Frame Query For Contacts" doc:id="7542afd0-733a-4abe-bfb6-e2b6c30f3bcf" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"update":"select Id, User__c from contact where User__c IN " ++ (payload default "")
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<salesforce:query doc:name="Query Contact" doc:id="c46dff3d-c5db-4c9d-930e-c30f0c572390" config-ref="Salesforce_Config">
			<salesforce:salesforce-query ><![CDATA[#[payload.update]]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Set Mapping for User Update" doc:id="0df2c720-06f6-4288-a1cc-554fc75f78ff" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map ((item,value)->{
	"ContactId":item.Id,
	"Id": item.User__c
})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="fbf05581-50ea-4035-a712-f69357c05910" collection="#[payload]" batchSize="100">
			<salesforce:update type="User" doc:name="Update User" doc:id="a3641db2-c2cb-4a00-a6ba-3e7f087b577b" config-ref="Salesforce_Config" />
		</foreach>
	</sub-flow>
	<sub-flow name="contacts-validation-final-subflow" doc:id="0f43d91b-0d78-44ab-9bef-edc438e285bb" >
		<salesforce:query doc:name="Query Contacts" doc:id="dd0275d0-f30a-40d9-a3a2-caf138f26fd9" config-ref="Salesforce_Config" >
			<salesforce:salesforce-query ><![CDATA[SELECT Id FROM Contact where User__c = null]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Extract SF-UserId" doc:id="e5697939-06e9-4136-a140-952561349734" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"('" ++ (payload.Id default [] joinBy "','") ++ "')"]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Frame Query For User" doc:id="0278375d-6308-4c5b-b8ae-0d8bbb07581b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"update":"select Id,ContactId from User where ContactId IN " ++ (payload default "")
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<salesforce:query doc:name="Query User" doc:id="7cb19b27-d2ef-4b6e-8112-5792070eb066" config-ref="Salesforce_Config">
			<salesforce:salesforce-query ><![CDATA[#[payload.update]]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Set Mapping for Contact Update" doc:id="c78bfb60-96c2-455a-a67d-66e90c7ded8f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map ((item,index)->{
	"Id": item.ContactId,
	"User__c": item.Id
})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="ef024bdf-5767-4873-b348-c2f3c5882163" collection="#[payload]" batchSize="100">
			<salesforce:update type="Contact" doc:name="Update Contact" doc:id="31294b85-a872-4c1e-a02a-54dbe989a8ca" config-ref="Salesforce_Config" />
		</foreach>
	</sub-flow>
	<sub-flow name="user-manager-update-subflow" doc:id="c4e027fa-bc73-4b4a-84a6-849544219a30" >
		<salesforce:query doc:name="Query User" doc:id="186fde71-fb5c-475f-8ec9-e72576a91e0f" config-ref="Salesforce_Config" target="userSFEmployeeNumbers">
			<salesforce:salesforce-query><![CDATA[SELECT Id, IsActive, EmployeeNumber FROM User where EmployeeNumber != null]]></salesforce:salesforce-query>
		</salesforce:query>
		<ee:transform doc:name="Set Manager &amp; User Mapping" doc:id="55a7627c-29af-48d1-a1e3-c5cf85b1fa61" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
vars.validWorkers map ((item,index)->{
	"Manager__c": do{
		var userData = (vars.userSFEmployeeNumbers filter($.EmployeeNumber == item.JobPositionDetail.SupervisorEmpId))[0]
		---
		if ( (userData != null) and
        (userData.IsActive == "true") ) (userData.Id)
        else "#N/A"
	},
	"User__c": do {
		var userData = (vars.userSFEmployeeNumbers filter($.EmployeeNumber == item.EmpId))[0]
		---
		if ( (userData != null) ) (userData.Id)
                else "#N/A"
	}
})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="9074f5b5-6d16-49e1-a960-ba893ce08864" collection="#[payload]" batchSize="100" >
			<salesforce:update type="Contact" doc:name="Update Contact" doc:id="1da58767-b4f9-401d-9a3f-eb2130ebf3d8" config-ref="Salesforce_Config" />
		</foreach>
	</sub-flow>
</mule>
